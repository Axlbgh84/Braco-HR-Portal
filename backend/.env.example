# --- Server ---
PORT=4000
NODE_ENV=production
FRONTEND_ORIGIN=https://braco-portal.netlify.app

# --- Postgres (Supabase connection string, "Session" pooler recommended for a long-lived server) ---
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Supabase (for Storage + freelancer magic-link auth) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never exposed to frontend
SUPABASE_STORAGE_BUCKET=braco-documents

# --- Microsoft Entra ID (staff SSO) ---
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-app-registration-client-id
ENTRA_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0

# --- Session tokens issued BY THIS API (not the raw Entra/Supabase tokens) ---
SESSION_JWT_SECRET=generate-a-long-random-string
SESSION_JWT_TTL=1h
REFRESH_TOKEN_TTL=30d

# --- Encryption key for banking details (pgcrypto pgp_sym_encrypt) ---
BANKING_ENCRYPTION_KEY=generate-a-long-random-string
